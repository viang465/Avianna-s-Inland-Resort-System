echo. > .gitignore
echo # Ignore node_modules >> .gitignore
echo node_modules/ >> .gitignore
echo # Ignore build output >> .gitignore

echo dist/ >> .gitignore
echo # Ignore logs >> .gitignore
echo logs/ >> .gitignore
echo # Ignore environment variables >> .gitignore
echo .env >> .gitignore
echo # Ignore IDE files >> .gitignore
echo .vscode/ >> .gitignore
echo .idea/ >> .gitignore
echo # Ignore OS files >> .gitignore